# Base de datos (Turso / libSQL).
#
# En producción (Netlify) crea una base gratuita en https://turso.tech y copia
# la URL y el token (turso db show / turso db tokens create).
# Si estas variables están vacías, la app usa un archivo SQLite local en
# data/gofun.db (solo para desarrollo; no persiste en serverless).
TURSO_DATABASE_URL=libsql://tu-base-tu-usuario.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# Secreto para firmar la cookie de sesión (HMAC-SHA256).
# En producción usa una cadena larga y aleatoria; si no se define, se usa un
# valor de desarrollo conocido.
GOFUN_SESION_SECRET=cambia-esta-cadena-en-produccion
