# Credenciales de Supabase (modo producción/equipo).
# Mientras estas variables tengan los valores de ejemplo, la app funciona
# en "modo local" con SQLite y el usuario admin / admin (ver README).
#
# Crea un proyecto en https://supabase.com/dashboard y copia estos valores
# desde Project Settings → API. Después de guardar, reinicia el servidor:
# la app detecta las credenciales y cambia a Supabase automáticamente.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY